{
  "name": "nisshin-refine",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter '*' dev",
    "generate:contracts": "bun run --cwd packages/validation generate:contracts",
    "generate:openapi": "bun run --cwd apps/backend openapi:export",
    "generate:api-types": "bun run --cwd packages/api-types generate:status",
    "generate:all": "bun run generate:contracts && bun run generate:openapi && bun run generate:api-types",
    "check:idempotent": "tmpdir=$(mktemp -d) && bun run generate:contracts && cp -R packages/validation/src/generated \"$tmpdir\"/generated && bun run generate:contracts && diff -qr \"$tmpdir\"/generated packages/validation/src/generated",
    "skills:sync": "sh scripts/codex/sync-skills.sh",
    "mcp:setup": "sh scripts/codex/setup-mcp.sh",
    "mcp:verify": "sh scripts/codex/setup-mcp.sh --verify",
    "hooks:install": "sh scripts/codex/install-hooks.sh",
    "hooks:verify": "sh scripts/codex/install-hooks.sh --verify",
    "lint": "oxlint .",
    "check:staged": "sh scripts/codex/check-staged.sh",
    "check:prepush": "sh scripts/codex/check-prepush.sh",
    "check:generated:clean": "sh scripts/codex/check-generated-clean.sh",
    "check:generated:no-new-diff": "sh scripts/codex/check-generated-no-new-diff.sh",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "oxlint": "^1.16.0"
  }
}
